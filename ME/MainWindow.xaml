<Window x:Class="ME.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ME.ViewModels"
        Title="ME" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MinWidth="900" MinHeight="600"
        WindowStyle="None"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeChanged="Window_SizeChanged"
        PreviewMouseMove="Window_PreviewMouseMove">
    <Grid>
        <!-- Invisible resize border (8px all around) -->
        <Border x:Name="ResizeBorder" MouseLeftButtonDown="ResizeBorder_MouseLeftButtonDown"
                Cursor="Arrow" Background="Transparent" />
        <Border x:Name="WindowBorder" Background="{DynamicResource BackgroundBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Margin="0">
            <Border.Clip>
                <RectangleGeometry x:Name="WindowClip" Rect="0,0,1184,684" RadiusX="12" RadiusY="12" />
            </Border.Clip>
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                    MouseMove="TitleBar_MouseMove">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="🎯" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="ME" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ThemeToggleBtn" Content="🌙" FontSize="12"
                                Width="36" Height="28" Click="ThemeToggle_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="切换主题" VerticalAlignment="Center" />
                        <Button x:Name="MinimizeBtn" Content="─" FontSize="12"
                                Width="36" Height="28" Click="Minimize_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource TextBrush}" />
                        <Button x:Name="MaximizeBtn" Content="□" FontSize="12"
                                Width="36" Height="28" Click="Maximize_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource TextBrush}" />
                        <Button x:Name="CloseBtn" Content="✕" FontSize="12"
                                Width="36" Height="28" Click="Close_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content: Nav + Workspace unified background -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Nav: same background as workspace, no border -->
                <Border Grid.Column="0" Background="{DynamicResource BackgroundBrush}">
                    <DockPanel>
                        <!-- 左下角云同步状态球：灰=未绑定/未同步，呼吸绿=同步中，绿=已同步，红=失败；点击重同步 -->
                        <Border x:Name="SyncBallBtn" DockPanel.Dock="Bottom" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonUp="SyncBall_Click" Margin="16,0,10,12" Padding="2,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SyncDot" Width="11" Height="11" VerticalAlignment="Center" Fill="#9CA3AF" />
                                <TextBlock x:Name="SyncBallText" Text="云同步" FontSize="11" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Opacity="0.7" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="NavList" ItemsSource="{Binding NavItems}"
                                 SelectionChanged="NavList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0" Margin="10,10,10,4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="Transparent"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                                    <Setter Property="TextElement.Foreground" Value="White" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True" />
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource NavSelectedHoverBrush}" />
                                                    <Setter Property="TextElement.Foreground" Value="White" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="14" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>
                </Border>

                <!-- Workspace: same background, cards provide visual separation -->
                <Grid Grid.Column="1" x:Name="ContentGrid" Margin="16,0,16,16" />
            </Grid>

            <!-- 云同步轻提示（HUD）：左下角自动淡出，不遮挡不抢占界面 -->
            <Border x:Name="SyncToast" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="99"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,44"
                    MaxWidth="380" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#E62E2E2E" CornerRadius="10" Padding="12,9">
                <StackPanel Orientation="Horizontal" MaxWidth="356">
                    <Ellipse x:Name="SyncToastDot" Width="8" Height="8" VerticalAlignment="Top" Margin="0,4,8,0" Fill="#22C55E" />
                    <TextBlock x:Name="SyncToastText" Text="" FontSize="12" TextWrapping="Wrap" Foreground="#F3F4F6" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
    </Grid>
</Window>
