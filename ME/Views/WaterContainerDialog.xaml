<Window x:Class="ME.Views.WaterContainerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Title="喝水容器" Height="460" Width="460"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Opacity="0.25" BlurRadius="24" ShadowDepth="2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseDown"
                    Background="{DynamicResource CardBrush}">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="3"
                                Background="{DynamicResource PrimaryBrush}"
                                VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="喝水容器管理" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                    <Button Content="✕" Click="Cancel_Click"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="8,2" FontSize="12"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="16,12,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="添加 / 修改容器" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />

                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" Width="64" />
                        <TextBox x:Name="NameBox" Style="{StaticResource InputTextBoxStyle}"
                                 Width="240" FontSize="13" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="容量(ml)" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" Width="64" />
                        <TextBox x:Name="CapacityBox" Style="{StaticResource InputTextBoxStyle}"
                                 Width="110" FontSize="13" />
                    </StackPanel>
                </StackPanel>

                <!-- 自动计算区域 -->
                <Border Grid.Row="2" Margin="0,8,0,8" Padding="10"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="按杯口直径 + 高度 自动计算容量（单位 cm）" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="直径" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="52" />
                            <TextBox x:Name="DiameterBox" Style="{StaticResource InputTextBoxStyle}"
                                     Width="90" FontSize="13" />
                            <TextBlock Text="cm" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="4,0,12,0" />
                            <TextBlock Text="高度" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="52" />
                            <TextBox x:Name="HeightBox" Style="{StaticResource InputTextBoxStyle}"
                                     Width="90" FontSize="13" />
                            <TextBlock Text="cm" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="计算容量" Click="Calc_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,4" FontSize="12" />
                            <TextBlock x:Name="CalcResultText" FontSize="12"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AddBtn" Content="添加容器" Click="Add_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" FontSize="13" />
                        <Button x:Name="UpdateBtn" Content="保存修改" Click="Update_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" FontSize="13"
                                Margin="8,0,0,0" Visibility="Collapsed" />
                        <Button x:Name="CancelEditBtn" Content="取消编辑" Click="CancelEdit_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" FontSize="13"
                                Margin="8,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="MsgText" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,4" />
                    <TextBlock Text="已有容器（点击行可编辑）" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,4" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ContainerListPanel" />
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8,16,16">
                <Button Content="完成" Click="Save_Click"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="24,8" FontSize="13" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
