<UserControl x:Class="ME.Views.TimeTrackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="TimeTrackView_Loaded"
             IsVisibleChanged="TimeTrackView_IsVisibleChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="400" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="500" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Unified Timer Card -->
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Clock + mode + status -->
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="13"
                                       FontWeight="Medium" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <!-- Mode switch tabs -->
                            <Border Height="26" Margin="80,0,0,0" HorizontalAlignment="Left" Width="158">
                                <Grid>
                                    <Border x:Name="ModeTabBg" CornerRadius="6" Background="{DynamicResource CardBrush}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SimpleModeTab" Grid.Column="0" Content="计时"
                                                Click="SimpleModeTab_Click" FontSize="11" Padding="0"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button x:Name="PomoModeTab" Grid.Column="1" Content="番茄钟"
                                                Click="PomoModeTab_Click" FontSize="11" Padding="0"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TimerStatusText" Text="" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Row 1: Large timer -->
                        <TextBlock Grid.Row="1" x:Name="TimerDisplay" Text="00:00:00"
                                   FontSize="56" FontWeight="Bold" TextAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,6,0,2" />

                        <!-- Row 2: Phase tabs (pomodoro only) + tag selector (simple only) -->
                        <Border Grid.Row="2" Height="32" Margin="40,0,40,6" Visibility="Collapsed">
                            <Grid>
                                <Border CornerRadius="6" Background="{DynamicResource CardBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="WorkTab" Grid.Column="0" Content="工作 25:00"
                                            Click="WorkTab_Click" FontSize="11" Padding="0"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="ShortBreakTab" Grid.Column="1" Content="短休 5:00"
                                            Click="ShortBreakTab_Click" FontSize="11" Padding="0"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="LongBreakTab" Grid.Column="2" Content="长休 15:00"
                                            Click="LongBreakTab_Click" FontSize="11" Padding="0"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- Tag selector (simple mode) - horizontal tag bar -->
                        <Border Grid.Row="2" x:Name="TagSelectorRow" Height="34" Margin="40,0,40,6"
                                Visibility="Visible">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="TagBarPanel" />
                            </ScrollViewer>
                        </Border>

                        <!-- Row 3: Control buttons (no start button) -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Button x:Name="PauseBtn" Content="⏸ 暂停"
                                    Click="PauseBtn_Click" FontSize="13" Padding="20,8"
                                    Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="StopBtn" Content="■ 停止"
                                    Click="StopBtn_Click" FontSize="13" Padding="20,8" Margin="6,0,0,0"
                                    Style="{StaticResource DangerButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="SkipBtn" Content="⏭ 跳过"
                                    Click="SkipBtn_Click" FontSize="11" Padding="10,6" Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="Add1Btn" Content="+1m"
                                    Click="Add1Btn_Click" FontSize="11" Padding="8,6" Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="Add5Btn" Content="+5m"
                                    Click="Add5Btn_Click" FontSize="11" Padding="8,6" Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="SettingsBtn" Content="⚙"
                                    Click="SettingsBtn_Click" FontSize="14" Padding="8,6" Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" ToolTip="番茄钟设置"
                                    Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Row 4: Progress bar (pomodoro only) -->
                        <ProgressBar Grid.Row="4" x:Name="ProgressBar" Height="4"
                                     Maximum="100" Value="0" Visibility="Collapsed" />

                        <!-- Row 5: Stats text -->
                        <TextBlock Grid.Row="5" x:Name="StatsText" Text="" FontSize="11"
                                   TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!-- Tags -->
                <Border Style="{StaticResource CardStyle}" Padding="12,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="标签 (点击开始/停止)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <Button Content="+标签" Click="AddTag_Click" Padding="8,2" FontSize="10"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TagItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Time Stats -->
                <Border Style="{StaticResource CardStyle}" Padding="12,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="时间统计" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="StatsDayBtn" Content="日" Click="StatsDay_Click" FontSize="10" Padding="6,2"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button x:Name="StatsWeekBtn" Content="周" Click="StatsWeek_Click" FontSize="10" Padding="6,2" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Name="StatsMonthBtn" Content="月" Click="StatsMonth_Click" FontSize="10" Padding="6,2" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Name="StatsYearBtn" Content="年" Click="StatsYear_Click" FontSize="10" Padding="6,2" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                            <WrapPanel x:Name="TodayStatsPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Gantt Chart -->
                <Border Margin="0,0,0,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="甘特图" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="GanttDateLabel" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border x:Name="GanttChartBorder" Style="{StaticResource CardStyle}" Padding="8"
                                SizeChanged="GanttBorder_SizeChanged">
                            <Canvas x:Name="GanttCanvas" MinHeight="120" />
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Gantt Detail Popup -->
                <Popup x:Name="GanttDetailPopup" Placement="Center" PlacementTarget="{Binding ElementName=GanttChartBorder}"
                       AllowsTransparency="True" StaysOpen="True" IsOpen="False">
                    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            MinWidth="320" MaxWidth="500" MaxHeight="500"
                            Margin="0,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect Opacity="0.25" BlurRadius="24" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" CornerRadius="14,14,0,0" MouseLeftButtonDown="DetailTitleBar_MouseDown"
                                    Background="{DynamicResource CardBrush}">
                                <Grid Margin="16,0">
                                    <StackPanel x:Name="DetailTitlePanel" Orientation="Horizontal" VerticalAlignment="Center" />
                                    <Button Content="✕" Click="GanttDetail_Close"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,2" FontSize="12"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="440" Margin="16,12,16,16">
                                <StackPanel x:Name="GanttDetailContent" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>

                <!-- Pie Charts: Weekly + Monthly -->
                <Border Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="标签用时分布" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="本周" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <Canvas x:Name="WeekPieCanvas" Width="120" Height="120" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="本月" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <Canvas x:Name="MonthPieCanvas" Width="120" Height="120" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Bottom Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,8">
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                      Background="Transparent" />

        <!-- Right Panel: Calendar + Records -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Calendar -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Content="◀" Click="PrevMonth_Click" DockPanel.Dock="Left"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                        <Button Content="▶" Click="NextMonth_Click" DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" />
                        <TextBlock x:Name="MonthLabel" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" />
                    </DockPanel>

                    <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,6">
                        <TextBlock Text="日" TextAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="一" TextAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="二" TextAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="三" TextAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="四" TextAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="五" TextAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="六" TextAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </UniformGrid>

                    <UniformGrid x:Name="CalendarGrid" Columns="7" />
                </DockPanel>
            </Border>

            <!-- Time Records under Calendar -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="时间记录" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="导出CSV" Click="ExportCsv_Click" Padding="8,3" FontSize="11"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="SortToggleBtn" Content="↑正序" Click="SortToggle_Click"
                                    Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="ClearRecordsBtn" Content="清空" Click="ClearRecords_Click"
                                    Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RecordsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
