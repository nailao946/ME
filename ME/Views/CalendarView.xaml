<UserControl x:Class="ME.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="CalendarView_IsVisibleChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- Calendar -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="12">
            <DockPanel>
                <!-- Month Navigation -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button Content="◀" Click="PrevMonth_Click" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,4" DockPanel.Dock="Left" FontSize="12" />
                    <Button Content="▶" Click="NextMonth_Click" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="8,4" DockPanel.Dock="Right" FontSize="12" />
                    <TextBlock x:Name="MonthTitle" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </DockPanel>

                <!-- Tag filter -->
                <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                    <StackPanel x:Name="TagFilterPanel" Orientation="Horizontal" />
                </ScrollViewer>

                <!-- Weekday Headers -->
                <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,6">
                    <TextBlock Text="日" FontSize="11" Foreground="{DynamicResource AccentRedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="一" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="二" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="三" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="四" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="五" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="六" FontSize="11" Foreground="{DynamicResource AccentRedBrush}" HorizontalAlignment="Center" />
                </UniformGrid>

                <!-- Calendar Grid -->
                <ItemsControl x:Name="CalendarGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="1" Cursor="Hand" MouseLeftButtonDown="Day_Click"
                                    MinHeight="70" CornerRadius="6"
                                    Background="{Binding CellBackground}"
                                    BorderBrush="{Binding CellBorder}"
                                    BorderThickness="1">
                                <StackPanel Margin="3">
                                    <!-- Day number circle -->
                                    <Border Width="22" Height="22" CornerRadius="11"
                                            Background="{Binding DayBackground}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Day}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding DayForeground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- Task bars -->
                                    <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="14"
                                                        CornerRadius="{Binding CornerRadius}"
                                                        Margin="{Binding BarMargin}"
                                                        Background="{Binding Color}" Opacity="{Binding Opacity}"
                                                        IsHitTestVisible="False">
                                                    <TextBlock Text="{Binding Title}" FontSize="8" Foreground="White"
                                                               Margin="3,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Day Tasks Sidebar -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
            <DockPanel>
                <!-- Task Stats (from Dashboard) -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="任务统计" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,3,0" Padding="4,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📊" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                <TextBlock Text="打卡率" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="CheckInRateText" Text="0%" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="1,0,1,0" Padding="4,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📅" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                <TextBlock Text="剩余天数" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="RemainingDaysText" Text="0" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="3,0,0,0" Padding="4,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔥" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,1" />
                                <TextBlock Text="连续打卡" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="StreakDaysText" Text="0天" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="StatsHint" Text="点击右侧任务卡片查看该任务的统计"
                               FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="SelectedDateTitle" DockPanel.Dock="Top" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"
                           Text="选择日期查看任务" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DayTaskPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
