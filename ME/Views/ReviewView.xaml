<UserControl x:Class="ME.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Period Selector -->
            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="定期盘点" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="DateRangeText" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TodayBtn" Content="今天" Click="PeriodBtn_Click"
                                Tag="Today"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" Margin="0,0,6,0" />
                        <Button x:Name="WeeklyBtn" Content="本周" Click="PeriodBtn_Click"
                                Tag="Week"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" Margin="0,0,6,0" />
                        <Button x:Name="MonthlyBtn" Content="本月" Click="PeriodBtn_Click"
                                Tag="Month"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" Margin="0,0,6,0" />
                        <Button x:Name="AllBtn" Content="全部" Click="PeriodBtn_Click"
                                Tag="All"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats Cards Row -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <!-- Completion Rate Ring -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,4,0" Padding="12,14">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="52" Height="52" Margin="0,0,0,8">
                            <Ellipse Stroke="{DynamicResource BackgroundBrush}" StrokeThickness="4" />
                            <Ellipse x:Name="RateRing" Stroke="{DynamicResource AccentGreenBrush}"
                                     StrokeThickness="4" StrokeDashArray="34.56" StrokeDashOffset="34.56"
                                     StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock x:Name="CompletionRateText" Text="0%"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="完成率" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RateTrendText" Text="" FontSize="10"
                                   Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tasks Completed -->
                <Border Style="{StaticResource CardStyle}" Margin="2,0,2,0" Padding="12,14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="CompletedCountText" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="完成任务" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock x:Name="CompletedTrendText" Text="" FontSize="10"
                                   Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Time Invested -->
                <Border Style="{StaticResource CardStyle}" Margin="2,0,2,0" Padding="12,14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TimeInvestedText" Text="0h" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPurpleBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="时间投入" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock x:Name="TimeDailyAvgText" Text="" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock x:Name="TimeTrendText" Text="" FontSize="10"
                                   Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Streak -->
                <Border Style="{StaticResource CardStyle}" Margin="4,0,0,0" Padding="12,14">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="StreakDaysText" Text="0" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentYellowBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="连续打卡" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock x:Name="StreakBestText" Text="" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Activity Heatmap + Time Allocation -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Goal Tree (migrated from 目标地图) -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="目标全局树" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <TreeView x:Name="GoalTreeView" Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource TextBrush}">
                                <TreeView.Resources>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Padding" Value="6,4" />
                                        <Setter Property="IsExpanded" Value="True" />
                                    </Style>
                                </TreeView.Resources>
                            </TreeView>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Time Allocation by Tag -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="时间分配" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <StackPanel x:Name="TimeAllocPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Time Statistics -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="时间统计" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />

                    <!-- Period Buttons -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="StatsTodayBtn" Content="今天" Click="StatsPeriodBtn_Click"
                                Tag="Today" Style="{StaticResource PrimaryButtonStyle}" Padding="12,4" Margin="0,0,6,0" />
                        <Button x:Name="StatsWeeklyBtn" Content="本周" Click="StatsPeriodBtn_Click"
                                Tag="Week" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,0" />
                        <Button x:Name="StatsMonthlyBtn" Content="本月" Click="StatsPeriodBtn_Click"
                                Tag="Month" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,0" />
                        <Button x:Name="StatsAllBtn" Content="全部" Click="StatsPeriodBtn_Click"
                                Tag="All" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" />
                    </StackPanel>

                    <!-- Tag Selector -->
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="120" Margin="0,0,0,12">
                        <WrapPanel x:Name="TagSelectorPanel" />
                    </ScrollViewer>

                    <!-- Chart Area -->
                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8"
                            Padding="16,12" Height="240" Margin="0,0,0,12">
                        <Grid x:Name="StatsChartGrid">
                            <Canvas x:Name="StatsChartCanvas" />
                        </Grid>
                    </Border>

                    <!-- Legend -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,12">
                        <WrapPanel x:Name="StatsLegendPanel" />
                    </ScrollViewer>

                    <!-- Summary Panel -->
                    <StackPanel x:Name="StatsSummaryPanel" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
