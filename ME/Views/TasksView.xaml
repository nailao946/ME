<UserControl x:Class="ME.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ME.Converters"
             IsVisibleChanged="TasksView_IsVisibleChanged">
    <UserControl.Resources>
        <converters:GoalTagColorConverter x:Key="TagColorConverter" />
        <converters:QuantitativeProgressConverter x:Key="QuantProgressConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Row 0: Calendar strip -->
            <RowDefinition Height="Auto" />   <!-- Row 1: Today goals + Timer + Stats -->
            <RowDefinition Height="Auto" />   <!-- Row 2: Add task + tag filter -->
            <RowDefinition Height="*" />      <!-- Row 3: Task list -->
        </Grid.RowDefinitions>

        <!-- Horizontal Calendar Strip: scroll wheel + today button -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="12,8"
                SizeChanged="DateStrip_SizeChanged"
                PreviewMouseWheel="DateStrip_MouseWheel">
            <DockPanel>
                <!-- Left button = Today (跳转到今天) -->
                <Button DockPanel.Dock="Left" Content="今天" Click="TodayBtn_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,8,0" FontSize="12" />
                <TextBlock x:Name="MonthLabel" DockPanel.Dock="Left" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                           Margin="0,0,16,0" MinWidth="60" />
                <ScrollViewer x:Name="DateScroller" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" ClipToBounds="True">
                    <StackPanel x:Name="DateStrip" Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Row 1: Today Goals (left) + Timer+Stats (right, compact, no ring) -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Today Goals (left, compact) -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" x:Name="TodayGoalsSection" Visibility="Collapsed"
                    Padding="12,8,12,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="今日目标" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                        <StackPanel x:Name="TodayGoalsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Timer + Stats (right, compact horizontal, no ring) -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12,6,12,6">
                <StackPanel>
                    <!-- Row 1: Timer controls (no start btn, tag bar instead) -->
                    <DockPanel Margin="0,0,0,4">
                        <Border x:Name="MiniDot" Width="6" Height="6" CornerRadius="3"
                                Background="Gray" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="MiniTag" Text="" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="MiniTimerText" Text="00:00:00" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="MiniStatus" Text="" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="MiniPauseBtn" Content="⏸" Click="MiniPause_Click"
                                FontSize="10" Padding="6,3" Margin="0,0,4,0" Visibility="Collapsed"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="MiniStopBtn" Content="■" Click="MiniStopBtn_Click"
                                FontSize="10" Padding="6,3" Margin="0,0,4,0" Visibility="Collapsed"
                                Style="{StaticResource DangerButtonStyle}" />
                        <!-- Tag scroll bar replaces combo -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Height="24" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,4,0">
                            <WrapPanel x:Name="MiniTagBar" VerticalAlignment="Center" />
                        </ScrollViewer>
                    </DockPanel>


                    <!-- Row 2: Stats (single horizontal line) -->
                    <DockPanel>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="8,3" Margin="0,0,6,0" Height="22">
                            <DockPanel>
                                <TextBlock Text="今日统计" FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock x:Name="MiniTotalTime" Text="" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Margin="0,0,6,0" Height="22">
                            <StackPanel x:Name="MiniStatsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="暂无数据" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ScrollViewer>
                        <Border x:Name="MiniTaskSummary" Visibility="Collapsed"
                                Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="8,3" Height="22">
                            <DockPanel>
                                <TextBlock Text="完成" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock x:Name="MiniCompletedCount" Text="0/0" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Add Task + Tag Filter -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <Button Content="+ 添加任务" Click="AddTask_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" FontSize="13"
                    DockPanel.Dock="Left" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          DockPanel.Dock="Right" Margin="8,0,0,0">
                <StackPanel x:Name="TagFilterPanel" Orientation="Horizontal" />
            </ScrollViewer>
        </DockPanel>

        <!-- Task List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TasksPanel" />
        </ScrollViewer>
    </Grid>
</UserControl>
