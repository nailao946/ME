<UserControl x:Class="ME.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="SettingsView_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧分类导航（微信/系统设置式：一个大类一页） -->
        <Border Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox x:Name="SettingsNav" BorderThickness="0" Background="Transparent" Padding="8,10"
                     SelectionChanged="SettingsNav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Content="🎨  外观" IsSelected="True" Padding="10,9" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                <ListBoxItem Content="⚙️  通用" Padding="10,9" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                <ListBoxItem Content="⏱  专注与统计" Padding="10,9" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                <ListBoxItem Content="💾  数据与备份" Padding="10,9" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                <ListBoxItem Content="☁️  GitHub 同步" Padding="10,9" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                <ListBoxItem Content="🧩  自定义模块" Padding="10,9" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                <ListBoxItem Content="🤖  AI 分析" Padding="10,9" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                <ListBoxItem Content="ℹ️  关于" Padding="10,9" FontSize="13" Foreground="{DynamicResource TextBrush}" />
            </ListBox>
        </Border>

        <!-- 右侧内容页 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsCardsPanel" MaxWidth="640" HorizontalAlignment="Left" Margin="20,16,20,20">
                <TextBlock x:Name="SettingsPageTitle" Text="外观" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" />

                <StackPanel x:Name="Sec_Appearance">
                    <!-- Theme Settings -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="外观设置" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="主题模式" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Width="100" />
                                <ComboBox x:Name="ThemeCombo" Width="120" SelectionChanged="ThemeCombo_Changed"
                                          Style="{StaticResource MacComboBoxStyle}">
                                    <ComboBoxItem Content="浅色" Tag="Light" />
                                    <ComboBoxItem Content="深色" Tag="Dark" />
                                    <ComboBoxItem Content="跟随系统" Tag="System" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="窗口边框颜色" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Width="100" />
                                <StackPanel x:Name="ColorBallsPanel" Orientation="Horizontal">
                                    <!-- Color balls are created in code-behind -->
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Sec_General" Visibility="Collapsed">
                    <!-- System Settings -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="系统设置" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="每周起始日" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Width="100" />
                                <ComboBox x:Name="WeekStartCombo" Width="120" SelectionChanged="WeekStart_Changed"
                                          Style="{StaticResource MacComboBoxStyle}">
                                    <ComboBoxItem Content="周一" Tag="1" />
                                    <ComboBoxItem Content="周日" Tag="0" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="AutoStartToggle" Checked="AutoStartToggle_Changed" Unchecked="AutoStartToggle_Changed"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="开机自动启动" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Windows启动时自动运行目标地图" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="24,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tray Settings -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="系统托盘" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="MinimizeToTrayToggle" Checked="TrayToggle_Changed" Unchecked="TrayToggle_Changed"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="最小化到系统托盘" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="关闭窗口时隐藏到托盘而非退出" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="24,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="TrayBalloonToggle" Checked="TrayBalloon_Changed" Unchecked="TrayBalloon_Changed"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="显示托盘通知气泡" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Floating Window Settings -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="悬浮窗" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="FloatingWindowToggle" Checked="FloatingWindow_Changed" Unchecked="FloatingWindow_Changed"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="显示悬浮计时窗" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="点击展开查看今日任务，拖动可移动位置，右键显示菜单" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="24,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Sec_Focus" Visibility="Collapsed">
                    <!-- Sound Settings -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="音效设置" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="SoundToggle" Checked="SoundToggle_Changed" Unchecked="SoundToggle_Changed"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="完成任务音效" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="完成或取消完成任务时播放提示音" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="24,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="FocusSoundToggle" Checked="FocusSound_Changed" Unchecked="FocusSound_Changed"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="专注计时器音效" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="番茄钟/专注计时结束时播放提示音" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="24,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Focus Timer Settings -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="专注设置" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="PomodoroAutoStartToggle" Checked="PomodoroAutoStart_Changed" Unchecked="PomodoroAutoStart_Changed"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="番茄钟自动开始" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="番茄钟/专注计时结束后自动开始下一个" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="24,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Stats Settings -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="统计设置" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="选择要纳入统计的时间标签" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="全选" Click="StatsTags_SelectAll"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,8,0" />
                                <Button Content="取消全选" Click="StatsTags_DeselectAll"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" />
                            </StackPanel>
                            <WrapPanel x:Name="StatsTagsPanel" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Sec_Data" Visibility="Collapsed">
                    <!-- Data Backup -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="数据备份" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />

                            <TextBlock Text="备份模式" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="BackupModePartial" Content="单独备份" GroupName="BackupMode"
                                             Checked="BackupMode_Changed" VerticalAlignment="Center" Margin="0,0,16,0"
                                             Foreground="{DynamicResource TextBrush}" />
                                <RadioButton x:Name="BackupModeFull" Content="全部备份" GroupName="BackupMode"
                                             Checked="BackupMode_Changed" VerticalAlignment="Center"
                                             Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>

                            <StackPanel x:Name="PartialBackupPanel" Margin="0,0,0,12">
                                <TextBlock Text="选择要备份的数据" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <CheckBox x:Name="BackupGoals" Content="目标" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="BackupTasks" Content="任务" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="BackupFocus" Content="专注" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="BackupSettings" Content="设置" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="BackupTags" Content="标签" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="BackupTimeRecords" Content="时间记录" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="BackupTimeTags" Content="时间标签" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="BackupHealth" Content="健康记录（睡眠/体重/喝水/心情/尿酸/锻炼/久坐）" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="BackupMeds" Content="用药记录" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="BackupContainers" Content="喝水容器" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                    <CheckBox x:Name="BackupExerciseItems" Content="锻炼项目" IsChecked="True" Margin="0,0,12,6"
                                              Foreground="{DynamicResource TextBrush}" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BackupBtn" Content="备份数据" Click="Backup_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Margin="0,0,8,0" />
                                <Button Content="导入数据" Click="Restore_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" />
                            </StackPanel>
                            <TextBlock x:Name="LastBackupText" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Cloud Sync -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="云同步" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="同步状态:" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="LastSyncTimeText" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" Text="未同步" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="导出数据" Click="ExportSyncData_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" />
                                <Button Content="导入小米健康数据" Click="ImportXiaomi_Click" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" />
                            </StackPanel>
                            <TextBlock Text="数据格式兼容Web版目标地图" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                            <TextBlock Text="小米健康导入：登录 account.xiaomi.com → 隐私中心 → 管理您的数据 → 小米运动健康 → 申请导出，下载 zip 后在此导入（解析睡眠与体重）。小米未开放实时接口，此为官方唯一数据通道。" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Sec_GitHub" Visibility="Collapsed">
                    <!-- GitHub Cloud Sync (PC ↔ Android) -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="GitHub 云同步（PC ↔ 安卓）" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="把数据上传到自己的 GitHub 私有仓库实现 PC / 安卓免费云同步。Token 需要 repo（Contents 读写）权限，用 DPAPI 加密保存，不会随数据上传。" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="仓库" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Width="100" />
                                <TextBox x:Name="SyncRepoBox" Width="240" FontSize="12" Padding="8,5,8,5" Text="ME-OKR"
                                         ToolTip="只填仓库名即可（自动创建私有仓库并挂到你的账号下），也可填 owner/仓库名" />
                                <TextBlock Text="分支" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Margin="16,0,0,0" Width="40" />
                                <TextBox x:Name="SyncBranchBox" Width="80" FontSize="12" Padding="8,5,8,5" Text="main" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="GitHub Token" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Width="100" />
                                <PasswordBox x:Name="SyncTokenBox" Width="240" FontSize="12" Padding="8,5,8,5"
                                             ToolTip="ghp_ 开头的 Personal Access Token（需要 repo 权限）" />
                                <TextBlock Text="代理(可选)" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Margin="16,0,0,0" Width="70" />
                                <TextBox x:Name="SyncProxyBox" Width="130" FontSize="12" Padding="8,5,8,5"
                                         ToolTip="如 http://127.0.0.1:7897，留空直连" />
                            </StackPanel>
                            <!-- 账号授权登录（GitHub Device Flow） -->
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="SyncAccountText" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"
                                               Text="未登录 GitHub 账号" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SyncLoginBtn" Content="账号授权登录" Click="SyncLogin_Click"
                                                Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Margin="0,0,8,0"
                                                ToolTip="跳转 GitHub 网页登录并点允许，自动获取 Token，无需手动创建" />
                                        <Button x:Name="SyncLogoutBtn" Content="退出登录" Click="SyncLogout_Click"
                                                Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" />
                                        <TextBlock x:Name="SyncLoginStatus" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button x:Name="SyncPushBtn" Content="上传数据" Click="SyncPush_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Margin="0,0,8,0" />
                                <Button x:Name="SyncPullBtn" Content="下载数据" Click="SyncPull_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" Margin="0,0,8,0" />
                                <TextBlock x:Name="SyncStatusText" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="SyncLastTimeText" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Sec_Modules" Visibility="Collapsed">
                    <!-- Custom Modules hint -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="自定义模块（可扩展记录块）" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="教程：在左侧导航打开「自定义模块」→ 点「＋ 新建模块」→ 填名称、选颜色和图标 → 添加字段（如「跑步」类型数值，单位 km）→ 保存。之后在模块卡片上点「记一笔」录入，点「历史」看趋势图。模块数据存于 custom_modules.json，随备份/云同步在 PC 与安卓互通，每个模块可随时编辑。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Sec_AI" Visibility="Collapsed">
                    <!-- AI Analysis (multi-provider) -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="AI 分析（多供应商）" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="在健康 → 对比 页面使用 AI 分析健康数据。支持 DeepSeek、通义、智谱等任意 OpenAI 兼容或 Anthropic 服务。" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="当前供应商" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Width="100" />
                                <ComboBox x:Name="AiProviderCombo" Width="220" Style="{StaticResource MacComboBoxStyle}"
                                          SelectionChanged="AiProviderCombo_Changed" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="＋ 添加供应商" Click="AddAiProvider_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Margin="0,0,8,0" />
                                <Button x:Name="EditAiProviderBtn" Content="编辑当前" Click="EditAiProvider_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" Margin="0,0,8,0" />
                                <Button x:Name="TestDeepSeekKeyBtn" Content="测试连接" Click="TestDeepSeekKey_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" />
                            </StackPanel>
                            <TextBlock Text="供应商信息（名称、API Key、请求地址、模型名、格式）在弹窗中配置，Key 用 DPAPI 加密保存。DeepSeek 官方 Key 获取：platform.deepseek.com → API Keys。" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBlock x:Name="DeepSeekStatusText" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Sec_About" Visibility="Collapsed">
                    <!-- About -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="关于目标地图" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                            <TextBlock x:Name="VersionText" Text="版本 1.0.0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="🔗 GitHub：" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" />
                                <Button Content="github.com/nailao946/OKR" Click="OpenGithub_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" FontSize="11"
                                        Cursor="Hand" ToolTip="点击打开项目 GitHub 页面" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="📱 作者微信：" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="WechatText" Text="shuaim888888" FontSize="12"
                                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Cursor="Hand" ToolTip="点击复制微信号"
                                           MouseLeftButtonDown="WechatText_MouseLeftButtonDown" />
                            </StackPanel>
                            <TextBlock Text="点击微信号可复制，欢迎反馈建议" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
