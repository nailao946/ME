<UserControl x:Class="ME.Views.CustomModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">
            <!-- 页头 -->
            <DockPanel Margin="0,4,0,10">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="自定义模块" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="像「健康」一样记录任何事 · PC 与安卓数据互通"
                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" TextElement.FontWeight="SemiBold" Content="＋ 新建模块"
                        Style="{DynamicResource PrimaryButtonStyle}" Padding="18,8"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddModule_Click" />
            </DockPanel>

            <!-- 模块切换 chips -->
            <StackPanel x:Name="ModuleChips" Orientation="Horizontal" Margin="0,0,0,12" />

            <!-- 仪表盘宿主 -->
            <StackPanel x:Name="DashboardHost" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
