<Window x:Class="ME.Views.MedicationEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ME.Views"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Title="用药记录" Height="700" Width="520"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Opacity="0.25" BlurRadius="24" ShadowDepth="2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseDown"
                    Background="{DynamicResource CardBrush}">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="3"
                                Background="{DynamicResource PrimaryBrush}"
                                VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="TitleText" Text="添加用药" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                    <Button Content="✕" Click="Cancel_Click"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="8,2" FontSize="12"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,14,20,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="药名" FontSize="13" Foreground="{DynamicResource TextBrush}"
                               Width="80" VerticalAlignment="Center" />
                    <TextBox x:Name="NameBox" Style="{StaticResource InputTextBoxStyle}"
                             Width="300" FontSize="13" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="药品类型" FontSize="13" Foreground="{DynamicResource TextBrush}"
                               Width="80" VerticalAlignment="Center" />
                    <ComboBox x:Name="TypeCombo" Width="200" Style="{StaticResource MacComboBoxStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="规格" FontSize="13" Foreground="{DynamicResource TextBrush}"
                               Width="80" VerticalAlignment="Center" />
                    <TextBox x:Name="SpecValueBox" Style="{StaticResource InputTextBoxStyle}"
                             Width="100" FontSize="13" />
                    <TextBlock Text="/" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" Margin="6,0,6,0" />
                    <ComboBox x:Name="UnitCombo" Width="140" Style="{StaticResource MacComboBoxStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="用药频率" FontSize="13" Foreground="{DynamicResource TextBrush}"
                               Width="80" VerticalAlignment="Center" />
                    <ComboBox x:Name="FreqCombo" Width="200" Style="{StaticResource MacComboBoxStyle}"
                              SelectionChanged="FreqCombo_Changed" />
                </StackPanel>

                <!-- 每隔 N 天 -->
                <StackPanel x:Name="EveryNDaysPanel" Orientation="Horizontal" Margin="80,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="每隔" FontSize="12" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="EveryNDaysBox" Style="{StaticResource InputTextBoxStyle}"
                             Width="70" Text="1" TextAlignment="Center" FontSize="12"
                             Margin="6,0,0,0" PreviewTextInput="DigitOnly_PreviewTextInput" />
                    <TextBlock Text="天" FontSize="12" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <!-- 循环定时（每 N 小时） -->
                <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="80,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="每" FontSize="12" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="IntervalHoursBox" Style="{StaticResource InputTextBoxStyle}"
                             Width="70" Text="8" TextAlignment="Center" FontSize="12"
                             Margin="6,0,0,0" PreviewTextInput="DigitOnly_PreviewTextInput" />
                    <TextBlock Text="小时" FontSize="12" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>

                <!-- 每周特定日期 -->
                <StackPanel x:Name="WeeklyDaysPanel" Orientation="Horizontal" Margin="80,8,0,0" Visibility="Collapsed">
                    <CheckBox x:Name="WMon" Content="一" Tag="1" Checked="WeeklyDay_Changed" Unchecked="WeeklyDay_Changed"
                              Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
                    <CheckBox x:Name="WTue" Content="二" Tag="2" Checked="WeeklyDay_Changed" Unchecked="WeeklyDay_Changed"
                              Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
                    <CheckBox x:Name="WWed" Content="三" Tag="3" Checked="WeeklyDay_Changed" Unchecked="WeeklyDay_Changed"
                              Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
                    <CheckBox x:Name="WThu" Content="四" Tag="4" Checked="WeeklyDay_Changed" Unchecked="WeeklyDay_Changed"
                              Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
                    <CheckBox x:Name="WFri" Content="五" Tag="5" Checked="WeeklyDay_Changed" Unchecked="WeeklyDay_Changed"
                              Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
                    <CheckBox x:Name="WSat" Content="六" Tag="6" Checked="WeeklyDay_Changed" Unchecked="WeeklyDay_Changed"
                              Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
                    <CheckBox x:Name="WSun" Content="日" Tag="7" Checked="WeeklyDay_Changed" Unchecked="WeeklyDay_Changed"
                              Foreground="{DynamicResource TextBrush}" />
                </StackPanel>

                <!-- 用药时间（可多个，按行排） -->
                <StackPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="用药时间" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                   Width="80" VerticalAlignment="Center" />
                        <Button Content="＋ 添加时间点" Click="AddTime_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"
                                FontSize="11" Margin="0,0,8,0" />
                    </StackPanel>
                    <StackPanel x:Name="TimesPanel" Margin="80,6,0,0" />
                    <TextBlock Text="可添加多个时间点，每个时间点一行，到点提醒（若开启）" FontSize="10"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="80,4,0,0" />
                </StackPanel>

                <!-- 用药提醒开关 -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="用药提醒" FontSize="13" Foreground="{DynamicResource TextBrush}"
                               Width="80" VerticalAlignment="Center" />
                    <CheckBox x:Name="RemindToggle" Content="开启提醒（到时间通过系统托盘通知）"
                              Foreground="{DynamicResource TextBrush}" FontSize="12"
                              VerticalAlignment="Center" />
                </StackPanel>

                <!-- 持续时间 -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="持续时间" FontSize="13" Foreground="{DynamicResource TextBrush}"
                               Width="80" VerticalAlignment="Center" />
                    <TextBlock Text="从" FontSize="12" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <local:CustomDatePicker x:Name="StartDatePicker" Margin="4,0,0,0" />
                    <TextBlock Text="到" FontSize="12" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <local:CustomDatePicker x:Name="EndDatePicker" Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="备注" FontSize="13" Foreground="{DynamicResource TextBrush}"
                               Width="80" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <TextBox x:Name="NoteBox" Style="{StaticResource InputTextBoxStyle}"
                             Width="360" Height="72" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" Padding="8" FontSize="12" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16">
                <Button Content="取消" Click="Cancel_Click"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="20,8" Margin="0,0,10,0" FontSize="13" />
                <Button Content="保存" Click="Save_Click"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="20,8" FontSize="13" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
