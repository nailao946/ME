<Window x:Class="ME.Views.NoteInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Title="备注" Height="260" Width="380"
        KeyDown="Window_KeyDown">
    <Border CornerRadius="14" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Opacity="0.25" BlurRadius="24" ShadowDepth="2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseDown"
                    Background="{DynamicResource CardBrush}">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="12" Height="12" CornerRadius="3"
                                Background="{DynamicResource PrimaryBrush}"
                                VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="时间备注" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                    <Button Content="✕" Click="Cancel_Click"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="8,2" FontSize="12"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20,14,20,0">
                <TextBlock x:Name="RecordTimeText" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                <TextBox x:Name="NoteInput" Style="{DynamicResource InputTextBoxStyle}"
                         Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="13" VerticalContentAlignment="Top" Padding="8" />
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16">
                <Button Content="清除" Click="Clear_Click"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="20,8" Margin="0,0,10,0" FontSize="13" />
                <Button Content="取消" Click="Cancel_Click"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="20,8" Margin="0,0,10,0" FontSize="13" />
                <Button Content="保存" Click="Save_Click"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="20,8" FontSize="13" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
