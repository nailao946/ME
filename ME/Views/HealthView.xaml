<UserControl x:Class="ME.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ME.Views"
             IsVisibleChanged="HealthView_IsVisibleChanged">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Category tabs -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="6" Margin="0,0,0,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OverviewTabBtn" Content="🏠 总览" Tag="overview" Click="Tab_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" Margin="0,0,8,0" FontSize="12" />
                <Button x:Name="SleepTabBtn" Content="😴 睡眠" Tag="sleep" Click="Tab_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0" FontSize="12" />
                <Button x:Name="WeightTabBtn" Content="⚖️ 身体测量" Tag="weight" Click="Tab_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0" FontSize="12" />
                <Button x:Name="WaterTabBtn" Content="💧 喝水" Tag="water" Click="Tab_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0" FontSize="12" />
                <Button x:Name="MoodTabBtn" Content="😊 心情" Tag="mood" Click="Tab_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0" FontSize="12" />
                <Button x:Name="UricAcidTabBtn" Content="💉 尿酸" Tag="uric_acid" Click="Tab_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0" FontSize="12" />
                <Button x:Name="ExerciseTabBtn" Content="🏃 锻炼" Tag="exercise" Click="Tab_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0" FontSize="12" />
                <Button x:Name="MedicationTabBtn" Content="💊 用药" Tag="medication" Click="Tab_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0" FontSize="12" />
                <Button x:Name="CompareTabBtn" Content="📊 对比" Tag="compare" Click="Tab_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0" FontSize="12" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ 总览面板 ============ -->
        <Grid Grid.Row="1" x:Name="OverviewPanel" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- 标题 + 导出报告 -->
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <DockPanel>
                    <Button x:Name="ExportReportBtn" Content="🖨️ 导出健康报告" Click="ExportReport_Click"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="16,8"
                            DockPanel.Dock="Right" />
                    <TextBlock Text="今日健康概况" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                </DockPanel>
            </Border>
            <!-- 汇总卡片（睡眠/体重/喝水等，上提到显眼位置） -->
            <WrapPanel x:Name="OverviewCardsPanel" Margin="0,10,0,0" />
            <!-- 主体：人体图（左）+ 详细信息（右） -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 人体图（在左，紧凑） -->
                    <Border Style="{StaticResource CardStyle}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="身体总览" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="点击部位查看数据" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,4"
                                       HorizontalAlignment="Center" />
                            <Canvas x:Name="BodyCanvas" Height="340" ClipToBounds="True"
                                    HorizontalAlignment="Center" Width="220" />
                        </StackPanel>
                    </Border>
                    <!-- 部位信息（与人体图同宽，放在其下方） -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="部位详细" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <StackPanel x:Name="OverviewDetailPanel" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
                <!-- 详细信息（右） -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="详细信息" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="OverviewInfoPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 睡眠面板 ============ -->
        <Grid Grid.Row="1" x:Name="SleepPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="记录睡眠" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="日期：" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <local:CustomDatePicker x:Name="SleepDatePicker" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="入睡" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="40" />
                            <TextBox x:Name="SleepHourBox" Width="76" Height="36" MaxLength="2"
                                     Text="23" TextAlignment="Center" Margin="6,0,0,0"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center" PreviewTextInput="DigitOnly_PreviewTextInput" />
                            <TextBlock Text="时" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="3,0,0,0" />
                            <TextBox x:Name="SleepMinBox" Width="76" Height="36" MaxLength="2"
                                     Text="00" TextAlignment="Center" Margin="3,0,0,0"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center" PreviewTextInput="DigitOnly_PreviewTextInput" />
                            <TextBlock Text="分" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="3,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="起床" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="40" />
                            <TextBox x:Name="WakeHourBox" Width="76" Height="36" MaxLength="2"
                                     Text="07" TextAlignment="Center" Margin="6,0,0,0"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center" PreviewTextInput="DigitOnly_PreviewTextInput" />
                            <TextBlock Text="时" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="3,0,0,0" />
                            <TextBox x:Name="WakeMinBox" Width="76" Height="36" MaxLength="2"
                                     Text="00" TextAlignment="Center" Margin="3,0,0,0"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center" PreviewTextInput="DigitOnly_PreviewTextInput" />
                            <TextBlock Text="分" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="3,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="SleepCalcText" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="保存" Click="SaveSleep_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Width="96" />
                            <Button Content="清除当天" Click="ClearSleep_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="96" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <UniformGrid Columns="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="今日" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="SleepTodayText" Text="--" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="周平均" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="SleepWeekAvgText" Text="--" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="月平均" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="SleepMonthAvgText" Text="--" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="近 7 天睡眠时长" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Canvas x:Name="SleepChartCanvas" Height="150" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="历史记录" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SleepRecordsPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 身体测量面板 ============ -->
        <Grid Grid.Row="1" x:Name="WeightPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="记录体重" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="日期：" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <local:CustomDatePicker x:Name="WeightDatePicker" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="体重(kg)" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="WeightBox" Width="110" Height="36" TextAlignment="Center"
                                     VerticalContentAlignment="Center" Margin="6,0,0,0" />
                            <TextBlock Text="身高(cm)" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                            <TextBox x:Name="HeightBox" Width="80" Height="36" TextAlignment="Center"
                                     VerticalContentAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="BmiText" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="保存" Click="SaveWeight_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Width="96" />
                            <Button Content="清除当天" Click="ClearWeight_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="96" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <UniformGrid Columns="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="最新体重" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="WeightLatestText" Text="--" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="BMI" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="BmiValueText" Text="--" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="本月变化" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="WeightChangeText" Text="--" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
                <!-- 身体成分分析 -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="身体成分分析" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="BodyCompGradeText" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,8,0,0" />
                        <TextBlock x:Name="BodyCompSuggestionText" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="BMI 区间（中国成人标准）" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,4" />
                        <Grid Height="16" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.25*" />
                                <ColumnDefinition Width="0.297*" />
                                <ColumnDefinition Width="0.25*" />
                                <ColumnDefinition Width="0.203*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#5AC8FA" CornerRadius="4,0,0,4" />
                            <Border Grid.Column="1" Background="#34C759" />
                            <Border Grid.Column="2" Background="#FFCC00" />
                            <Border Grid.Column="3" Background="#FF3B30" CornerRadius="0,4,4,0" />
                            <Border x:Name="BmiMarker" Width="3" Height="18"
                                    HorizontalAlignment="Left" Background="Black"
                                    Margin="-1.5,0,0,0" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.25*" />
                                <ColumnDefinition Width="0.297*" />
                                <ColumnDefinition Width="0.25*" />
                                <ColumnDefinition Width="0.203*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="偏瘦 &lt;18.5" FontSize="9"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="正常 18.5-24" FontSize="9"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="超重 24-28" FontSize="9"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="肥胖 ≥28" FontSize="9"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Grid>
                        <TextBlock x:Name="BodyCompTargetText" FontSize="11"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="WeightChartTitle" Text="体重趋势" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="从" FontSize="11" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <local:CustomDatePicker x:Name="WeightFromPicker" Margin="4,0,0,0" />
                            <TextBlock Text="到" FontSize="11" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <local:CustomDatePicker x:Name="WeightToPicker" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="WRange7Btn" Content="近7天" Tag="7" Click="WeightRange_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="24" FontSize="10"
                                    Padding="8,0" />
                            <Button x:Name="WRange30Btn" Content="近1月" Tag="30" Click="WeightRange_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="24" FontSize="10"
                                    Padding="8,0" Margin="4,0,0,0" />
                            <Button x:Name="WRange90Btn" Content="近3月" Tag="90" Click="WeightRange_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="24" FontSize="10"
                                    Padding="8,0" Margin="4,0,0,0" />
                            <Button x:Name="WRange365Btn" Content="近1年" Tag="365" Click="WeightRange_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="24" FontSize="10"
                                    Padding="8,0" Margin="4,0,0,0" />
                            <Button x:Name="WRangeAllBtn" Content="全部" Tag="0" Click="WeightRange_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="24" FontSize="10"
                                    Padding="8,0" Margin="4,0,0,0" />
                            <TextBlock x:Name="WeightDeltaText" FontSize="11"
                                       Foreground="{DynamicResource AccentGreenBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <Canvas x:Name="WeightChartCanvas" Height="170" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="历史记录" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="WeightRecordsPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 喝水面板 ============ -->
        <Grid Grid.Row="1" x:Name="WaterPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="今日喝水" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock x:Name="WaterTodayCountText" Text="0" FontSize="40" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="WaterTargetText" Text="/ 2000 ml" FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom" Margin="4,0,0,8" />
                        </StackPanel>
                        <ProgressBar x:Name="WaterProgressBar" Height="10" Margin="0,10,0,0"
                                     Background="{DynamicResource BackgroundBrush}"
                                     Foreground="{DynamicResource AccentBlueBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="选择容器" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="WaterContainerCombo" Width="150" Margin="6,0,0,0"
                                      Style="{StaticResource MacComboBoxStyle}" SelectionChanged="WaterContainerCombo_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{Binding CapacityMl, StringFormat='（{0:0} ml）'}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="管理容器" Click="ManageContainers_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="30"
                                    Margin="8,0,0,0" FontSize="11" Padding="10,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="− 1" Click="WaterMinus_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="64" Height="34" />
                            <Button Content="+ 1" Click="WaterPlus_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Width="64" Height="34" Margin="8,0,0,0" />
                            <TextBlock x:Name="WaterStepText" FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="目标(ml)：" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="WaterGoalBox" Width="80" Text="2000" TextAlignment="Center"
                                     VerticalContentAlignment="Center" Margin="6,0,0,0" />
                            <Button Content="保存目标" Click="SaveWaterGoal_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="30"
                                    Margin="8,0,0,0" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="统计" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Button x:Name="WaterPeriodTodayBtn" Content="今日" Tag="today" Click="WaterPeriod_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Height="26" FontSize="11"
                                    Padding="10,0" Margin="14,0,4,0" />
                            <Button x:Name="WaterPeriodWeekBtn" Content="本周" Tag="week" Click="WaterPeriod_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="26" FontSize="11"
                                    Padding="10,0" Margin="0,0,4,0" />
                            <Button x:Name="WaterPeriodMonthBtn" Content="本月" Tag="month" Click="WaterPeriod_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="26" FontSize="11"
                                    Padding="10,0" Margin="0,0,0,0" />
                        </StackPanel>
                        <UniformGrid Columns="3" Margin="0,10,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="WaterPeriodLabel" Text="平均" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="WaterAvgText" Text="0 ml" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentGreenBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="达标率" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="WaterRateText" Text="0%" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="合计" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="WaterTotalText" Text="0 ml" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentRedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="WaterChartTitle" Text="近 7 天喝水" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Canvas x:Name="WaterChartCanvas" Height="150" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="历史记录" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="WaterRecordsPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 心情面板 ============ -->
        <Grid Grid.Row="1" x:Name="MoodPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="今日心情" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="MoodTodayHint" Text="点击选择今天的心情"
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                        <UniformGrid Columns="4" Margin="0,14,0,0">
                            <Button x:Name="MoodBtn0" Content="😊" Tag="0" Click="Mood_Click" FontSize="30"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="52" Height="52"
                                    Padding="0" Margin="0,0,6,0" />
                            <Button x:Name="MoodBtn1" Content="😐" Tag="1" Click="Mood_Click" FontSize="30"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="52" Height="52"
                                    Padding="0" Margin="0,0,6,0" />
                            <Button x:Name="MoodBtn2" Content="😔" Tag="2" Click="Mood_Click" FontSize="30"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="52" Height="52"
                                    Padding="0" Margin="0,0,6,0" />
                            <Button x:Name="MoodBtn3" Content="😢" Tag="3" Click="Mood_Click" FontSize="30"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="52" Height="52"
                                    Padding="0" />
                        </UniformGrid>
                        <TextBlock x:Name="MoodSelectedText" FontSize="12"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,12,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="清除今天" Click="ClearMood_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="100" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="近 7 天心情分布" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                        <StackPanel x:Name="MoodDistributionPanel" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="近 30 天心情" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <WrapPanel x:Name="MoodTimelinePanel" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="心情记录" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MoodRecordsPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 尿酸面板 ============ -->
        <Grid Grid.Row="1" x:Name="UricAcidPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="记录尿酸" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="日期：" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <local:CustomDatePicker x:Name="UricAcidDatePicker" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="尿酸值" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="UricAcidBox" Width="120" TextAlignment="Center"
                                     VerticalContentAlignment="Center" Margin="6,0,0,0"
                                     PreviewTextInput="UricValue_PreviewTextInput" />
                            <TextBlock Text="μmol/L" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="测量时间" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="UricHourBox" Width="76" MaxLength="2"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     TextAlignment="Center" Margin="6,0,0,0"
                                     VerticalContentAlignment="Center" PreviewTextInput="DigitOnly_PreviewTextInput" />
                            <TextBlock Text="时" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="3,0,0,0" />
                            <TextBox x:Name="UricMinBox" Width="76" MaxLength="2"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     TextAlignment="Center" Margin="3,0,0,0"
                                     VerticalContentAlignment="Center" PreviewTextInput="DigitOnly_PreviewTextInput" />
                            <TextBlock Text="分" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="3,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="性别（用于判断范围）" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="UricGenderCombo" Width="100" Margin="6,0,0,0"
                                      Style="{StaticResource MacComboBoxStyle}" SelectionChanged="UricGenderCombo_Changed">
                                <ComboBoxItem Content="男" Tag="male" />
                                <ComboBoxItem Content="女" Tag="female" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="目标尿酸" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="UricTargetBox" Width="120" Height="36" TextAlignment="Center"
                                     VerticalContentAlignment="Center" Margin="6,0,0,0" />
                            <TextBlock Text="μmol/L" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                            <Button Content="保存目标" Click="SaveUricTarget_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="30"
                                    Margin="8,0,0,0" FontSize="11" />
                        </StackPanel>
                        <TextBlock x:Name="UricAcidHint" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="保存" Click="SaveUricAcid_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Width="96" />
                            <Button Content="清除当天" Click="ClearUricAcid_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="96" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="正常范围参考（μmol/L）" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="男性：149 ~ 416　女性：89 ~ 357" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="高于上限为高尿酸血症，低于下限需关注营养状况" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="UricLatestText" Text="--" FontSize="18" FontWeight="Bold"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="近 30 天尿酸趋势" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="UricRangeText" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                        <Canvas x:Name="UricChartCanvas" Height="170" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="尿酸记录" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="UricRecordsPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 锻炼面板 ============ -->
        <Grid Grid.Row="1" x:Name="ExercisePanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="记录锻炼" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="项目：" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="ExerciseItemCombo" Width="210" Margin="6,0,0,0"
                                      Style="{StaticResource MacComboBoxStyle}"
                                      SelectionChanged="ExerciseItemCombo_Changed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="本次量：" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="ExerciseValueBox" Width="100" Height="36" TextAlignment="Center"
                                     Style="{StaticResource InputTextBoxStyle}" Text="1"
                                     VerticalContentAlignment="Center" Margin="6,0,0,0"
                                     PreviewTextInput="UricValue_PreviewTextInput" />
                            <TextBlock x:Name="ExerciseUnitText" Text="次" FontSize="12"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ExerciseHintText" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="＋ 记录本次" Click="RecordExercise_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Width="110" />
                            <Button Content="＋ 新建项目" Click="AddExerciseItem_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Width="110" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="🚶 久坐活动" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="每起身活动一次点一下，统计每天活动次数" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="SedentaryPlusBtn" Content="＋ 起身活动一次" Click="SedentaryPlus_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="16,10" FontSize="13" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="今日" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock x:Name="SedentaryTodayText" Text="0 次" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Canvas x:Name="SedentaryChartCanvas" Height="90" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="锻炼项目" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ExerciseItemsPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="今日达标" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <StackPanel x:Name="ExerciseTodayPanel" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="近 7 天锻炼量" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Canvas x:Name="ExerciseChartCanvas" Height="150" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="历史记录" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ExerciseRecordsPanel" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 对比面板 ============ -->
        <Grid Grid.Row="1" x:Name="ComparePanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="选择对比参数" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="勾选 2 项以上参数，看它们之间的趋势关联（数值已归一化）"
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,8" />
                        <CheckBox x:Name="CmpWater" Content="💧 喝水" IsChecked="True"
                                  Checked="CompareParam_Changed" Unchecked="CompareParam_Changed"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                        <CheckBox x:Name="CmpSleep" Content="😴 睡眠" IsChecked="True"
                                  Checked="CompareParam_Changed" Unchecked="CompareParam_Changed"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                        <CheckBox x:Name="CmpWeight" Content="⚖️ 体重" IsChecked="False"
                                  Checked="CompareParam_Changed" Unchecked="CompareParam_Changed"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                        <CheckBox x:Name="CmpUric" Content="💉 尿酸" IsChecked="True"
                                  Checked="CompareParam_Changed" Unchecked="CompareParam_Changed"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                        <CheckBox x:Name="CmpMood" Content="😊 心情" IsChecked="False"
                                  Checked="CompareParam_Changed" Unchecked="CompareParam_Changed"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="时间范围" FontSize="12" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="CmpRange7Btn" Content="近 7 天" Tag="7" Click="CompareRange_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="26" FontSize="11"
                                    Padding="10,0" Margin="10,0,4,0" />
                            <Button x:Name="CmpRange30Btn" Content="近 30 天" Tag="30" Click="CompareRange_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Height="26" FontSize="11"
                                    Padding="10,0" Margin="0,0,4,0" />
                            <Button x:Name="CmpRangeAllBtn" Content="全部" Tag="0" Click="CompareRange_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="26" FontSize="11"
                                    Padding="10,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="AI 分析" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="把所选参数这段时间的数据发给 AI 分析相关性（使用 设置 → AI 分析 中的默认供应商）"
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,8" TextWrapping="Wrap" />
                        <TextBlock Text="发送给 AI 的数据" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <RadioButton x:Name="AiScopeSelected" GroupName="AiScope" Content="仅上方勾选的参数"
                                     IsChecked="True" Margin="0,4,0,2" FontSize="12"
                                     Foreground="{DynamicResource TextBrush}" />
                        <RadioButton x:Name="AiScopeAll" GroupName="AiScope"
                                     Content="全部数据（含用药、锻炼、久坐等）" Margin="0,0,0,8" FontSize="12"
                                     Foreground="{DynamicResource TextBrush}" />
                        <Button x:Name="AiAnalyzeBtn" Content="🤖 开始 AI 分析" Click="AiAnalyze_Click"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="12" />
                        <TextBlock x:Name="AiStatusText" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="📄 查看提示词" Click="ShowAiPrompt_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,3"
                                    Height="26" FontSize="10" />
                            <TextBlock x:Name="AiPromptPreview" FontSize="10"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150"
                                       ToolTip="点击查看完整提示词" />
                        </StackPanel>
                        <!-- AI 分析结果（紧跟 AI 分析下面） -->
                        <TextBlock Text="AI 分析结果" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0" />
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <TextBlock x:Name="AiResultText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBrush}" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="趋势对比" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock DockPanel.Dock="Top" Text="每个参数按各自数据单独绘制折线，便于观察各自走势（图多可滚动）"
                               FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <StackPanel>
                            <StackPanel x:Name="CompareChartsPanel" />
                            <WrapPanel x:Name="CompareLegendPanel" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ 用药面板 ============ -->
        <Grid Grid.Row="1" x:Name="MedicationPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <DockPanel>
                    <Button Content="＋ 添加用药" Click="AddMedication_Click"
                            Style="{StaticResource PrimaryButtonStyle}" Padding="14,6"
                            DockPanel.Dock="Top" HorizontalAlignment="Right" FontSize="12" />
                    <TextBlock DockPanel.Dock="Top" Text="用药记录" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MedicationRecordsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
