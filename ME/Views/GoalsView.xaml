<UserControl x:Class="ME.Views.GoalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ME.Converters"
             IsVisibleChanged="GoalsView_IsVisibleChanged">
    <UserControl.Resources>
        <converters:GoalTagColorConverter x:Key="TagColorConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="+ 新建目标" Click="AddGoal_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"
                    DockPanel.Dock="Right" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,16,0">
                <Button x:Name="TagManageBtn" Content="管理标签" Click="ManageTags_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" />
            </StackPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Margin="0,0,8,0">
                <StackPanel x:Name="TagFilterPanel" Orientation="Horizontal" />
            </ScrollViewer>
        </DockPanel>

        <!-- Timer bar (no start btn, tag bar instead) -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,6" Margin="0,0,0,12">
            <DockPanel>
                <Border x:Name="GoalDot" Width="6" Height="6" CornerRadius="3"
                        Background="Gray" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock x:Name="GoalTag" Text="" FontSize="10"
                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="GoalTimerText" Text="00:00:00" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="GoalStatus" Text="" FontSize="10"
                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="GoalPauseBtn" Content="⏸" Click="GoalPause_Click"
                        FontSize="10" Padding="6,3" Margin="0,0,4,0" Visibility="Collapsed"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="GoalStopBtn" Content="■" Click="GoalStopBtn_Click"
                        FontSize="10" Padding="6,3" Margin="0,0,4,0" Visibility="Collapsed"
                        Style="{StaticResource DangerButtonStyle}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Height="24" VerticalAlignment="Center" Margin="0,0,4,0">
                    <WrapPanel x:Name="GoalTagBar" VerticalAlignment="Center" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="GoalsPanel" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
